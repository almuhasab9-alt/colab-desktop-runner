<?xml version="1.0" encoding="utf-8"?>
<!--
  إعداد أمان الشبكة: منع أي اتصال HTTP غير مشفر (cleartext) نهائيًا.
  جميع الاتصالات يجب أن تكون HTTPS فقط.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
